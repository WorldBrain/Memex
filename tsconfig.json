{
    "compilerOptions": {
        "baseUrl": ".",
        "allowJs": true,
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "node",
        "jsx": "react",
        "noImplicitAny": false,
        "sourceMap": true,
        "importHelpers": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "skipDefaultLibCheck": true,
        "skipLibCheck": true,
        "strictNullChecks": false,
        "outDir": "tmp",
        "types": ["chrome", "vite/client"],
        "paths": {
            "src/*": ["src/*"],
            "@worldbrain/memex-common/*": [
                "external/@worldbrain/memex-common/*"
            ],
            "@worldbrain/storex": ["external/@worldbrain/storex/ts"],
            "@worldbrain/storex-backend-dexie/ts": [
                "external/@worldbrain/storex-backend-dexie/ts"
            ],
            "@worldbrain/storex-pattern-modules/ts": [
                "external/@worldbrain/storex-pattern-modules/ts"
            ],
            "@worldbrain/memex-stemmer/*": [
                "external/@worldbrain/memex-stemmer/*"
            ],
            "@worldbrain/storex-backend-dexie": [
                "external/@worldbrain/storex-backend-dexie"
            ]
        },
        "lib": [
            "ES2019",
            "ES2020",
            "dom",
            "dom.iterable",
            "WebWorker",
            "esnext.asynciterable"
        ]
    },
    "include": [
        "./src/**/*",
        "src/common-ui/components/prompt-templates",
        "external/@worldbrain/memex-common/ts/**/*",
        "external/@worldbrain/storex/ts/**/*",
        "external/@worldbrain/storex-backend-dexie/ts/**/*",
        "external/@worldbrain/storex-pattern-modules/ts/**/*"
    ],
    "exclude": ["node_modules", "./src/**/*.js", "./src/**/*.jsx"]
}
